{%- comment -%}
  ============================================================================
  template-collection  —  CORRECTED
  ----------------------------------------------------------------------------
  Key changes vs original:
  1. REMOVED the jQuery `$(".sidebar-filter").clone().appendTo(".cat-popup")`.
     That clone created duplicate element IDs and a second, desynced copy of
     every filter control — the main cause of the filter misbehaving.
     The mobile "popup" is now the *same* sidebar node, shown/hidden by CSS.
  2. Sort no longer drops active filters / `q` / has malformed URLs. It now
     preserves the current query string and just sets `sort_by`, then
     navigates (server renders correct filtered + sorted results).
  3. Filtering is handled entirely by the native GET form in filters.liquid,
     so no fragile grid-swap AJAX remains here.
  4. Vanilla toggle for the mobile panel (jQuery no longer required by this
     template — the include is kept only in case other snippets rely on it;
     remove it if nothing else does).
  ============================================================================
{%- endcomment -%}

<style>
  .products-grid .product-image-container {
    outline-color: #bdbdbd;
    outline-style: solid;
    outline-width: 1px;
    border: 10px solid transparent;
  }
  .products-grid a:hover .product-image-container {
    border-image: url("{{ 'pattern-271.jpg' | asset_url }}") 10 round;
    outline-color: transparent;
  }

  .product-code { color: #acacac; }
  .product-compare-price span { color: #bdbdbd; }
  #sort-by { border-color: #bdbdbd; }

  .sidebar-filter { max-width: 225px; }

  /* --- MOBILE (<=1024px): the sidebar itself becomes the slide-up panel --- */
  @media screen and (max-width: 1024px) {
    .sidebar-filter {
      position: fixed;
      background: #fff;
      width: 90%;
      max-width: 300px;
      padding: 2em;
      right: 0;
      bottom: 1em;
      border: 1px solid;
      z-index: 20;
      max-height: 70vh;
      overflow: auto;
      opacity: 0;
      transform: translateY(100vh);
      transition: transform .3s ease, opacity .3s ease;
      pointer-events: none;
    }
    .sidebar-filter.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .sidebar-filter .filter-close {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      background: var(--yellow);
      font-weight: 700;
      padding: 0.5em 1em;
      z-index: 21;
      cursor: pointer;
    }
    .mobile-filter {
      border: 1px solid #bdbdbd;
      margin-top: 1em;
    }
    .mobile-filter:hover {
      background: var(--yellow);
      border-color: var(--yellow);
    }
  }

  /* --- DESKTOP (>=1025px): normal static sidebar --- */
  @media screen and (min-width: 1025px) {
    .mobile-filter,
    .sidebar-filter .filter-close { display: none; }
    .sidebar-filter { display: block; margin-right: 75px; }
  }

  @media screen and (min-width: 1170px) {
    .products-grid { width: 870px; }
    .products-grid .product-image-container { min-height: 280px; }
  }
</style>

{%- comment -%}
  jQuery retained only in case other snippets on this template depend on it.
  This template no longer uses it. Safe to remove if unused elsewhere.
{%- endcomment -%}
<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sidebar  = document.querySelector('.sidebar-filter');
    var openBtn  = document.querySelector('.mobile-filter');

    // Inject a close control for the mobile panel (no cloning of filter markup).
    if (sidebar && !sidebar.querySelector('.filter-close')) {
      var close = document.createElement('span');
      close.className = 'filter-close';
      close.textContent = 'X';
      sidebar.prepend(close);
      close.addEventListener('click', function () { sidebar.classList.remove('active'); });
    }
    if (openBtn && sidebar) {
      openBtn.addEventListener('click', function () { sidebar.classList.toggle('active'); });
    }

    // Legacy category <select> (currently commented out in markup) — harmless if absent.
    var catDrop = document.querySelector('.cat-drop');
    if (catDrop) {
      catDrop.addEventListener('change', function () { if (this.value) { window.location.href = this.value; } });
    }
  });
</script>

{% render 'stripe-pattern' %}

<div class="container mx-auto xct:flex xct:justify-between py-50px lg:py-100px">
  {% paginate collection.products by 12 %}

    <div class="sidebar-filter">
      <div class="category-filter pb-6 xct:pb-14">
        {% if collection.handle != 'all' %}
          <a href="javascript: history.go(-1)" class="back-btn flex items-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 max-w-[20px] block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back
          </a>
        {% endif %}

        <h4 class="uppercase font-extrabold text-lg font-euro border-b pb-4 mb-7 border-wc-black">Shop by categories</h4>
        <span class="main-cat">
          {% if collection.handle == 'all' %}
            <a href="/collections/all" class="text-lg block">All</a>
          {% endif %}
          {% for product_type in collection.all_types %}
            {% if product_type == blank %}{% continue %}{% endif %}
            {{ product_type | link_to_type: class: 'text-lg block' }}
          {% endfor %}
        </span>
      </div>

      {% render 'filters', results: collection %}
    </div>

    <div>
      <div class="mt-11 lg:mt-0 flex flex-col md:flex-row justify-between items-center">
        <h1 class="uppercase text-3xl">{{ collection.title }}</h1>

        <div class="flex items-center">
          <p class="uppercase font-euro font-extrabold mr-4">Sort by</p>
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}

          <div class="collection__sort flex justify-end"
            x-data="{
              loading: false,
              sort: '{{ sort_by }}',
              applySort() {
                this.loading = true;
                // Preserve every current param (filters, q, etc.) and just set sort_by.
                const params = new URLSearchParams(window.location.search);
                params.set('sort_by', this.sort);
                window.location.search = params.toString();
              }
            }">

            {% render 'loader' %}

            <select id="sort-by" x-model="sort" @change="applySort()" class="py-3 px-4 my-3 border border-black">
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>

        <button class="mobile-filter wc-btn uppercase" type="button">Filters</button>
      </div>

      <div class="products-grid py-50px lg:pb-100px grid grid-cols-2 gap-y-10 place-content-center lg:grid-cols-2 xct:grid-cols-3 gap-x-30px lg:gap-y-12">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>There are no products inside of this collection.</p>
        {% endfor %}
        {% render 'pagination-custom', pagination: paginate %}
      </div>
    </div>

  {% endpaginate %}
</div>
